  <style>
    :root {
      color-scheme: light;
      --brand: #444F6C;
      --brand-dark: #000000;
      --accent: #4DB4F2;
      --accent-soft: rgba(77, 180, 242, 0.14);
      --text: #000000;
      --muted: #7D7F87;
      --border: #9C9EA6;
      --success: #417866;
      --warning: #A6535F;
      --surface: #FFFFFF;
      --page: #FFFFFF;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: var(--page);
      color: var(--text);
      font-family: Arial, Helvetica, sans-serif;
      line-height: 1.45;
    }

    .page {
      width: min(1040px, 100%);
      margin: 0 auto;
      padding: 24px 14px 42px;
    }

    .hero {
      background: var(--brand);
      color: var(--page);
      border-radius: 20px;
      padding: 24px;
      box-shadow: 0 20px 50px rgba(68, 79, 108, 0.18);
    }

    .hero h1 {
      margin: 0 0 8px;
      font-size: clamp(24px, 6vw, 40px);
      line-height: 1.08;
      letter-spacing: -0.03em;
    }

    .hero p {
      margin: 0;
      color: rgba(255, 255, 255, 0.9);
      font-size: 16px;
    }

    .grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(320px, 430px);
      gap: 20px;
      margin-top: 20px;
      align-items: start;
    }

    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 18px;
      box-shadow: 0 12px 34px rgba(68, 79, 108, 0.10);
    }

    .card h2 {
      margin: 0 0 14px;
      font-size: 20px;
      letter-spacing: -0.01em;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .field {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .field.full {
      grid-column: 1 / -1;
    }

    label {
      font-size: 13px;
      font-weight: 700;
      color: var(--brand-dark);
    }

    input,
    select {
      width: 100%;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 12px 13px;
      color: var(--text);
      background: var(--page);
      font: 16px Arial, Helvetica, sans-serif;
      outline: none;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    input:focus,
    select:focus {
      border-color: var(--brand);
      box-shadow: 0 0 0 4px var(--accent-soft);
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 18px;
      justify-content: center;
    }

    button {
      appearance: none;
      border: 0;
      border-radius: 999px;
      padding: 12px 16px;
      font: 700 15px Arial, Helvetica, sans-serif;
      cursor: pointer;
      transition: transform 0.12s ease, box-shadow 0.12s ease, background 0.12s ease;
    }

    button:active {
      transform: translateY(1px);
    }

    .primary {
      color: var(--page);
      background: var(--brand);
      box-shadow: 0 8px 18px rgba(68, 79, 108, 0.22);
      padding: 12px 64px;
    }

    .secondary {
      color: var(--brand);
      background: var(--accent-soft);
    }

    .status {
      min-height: 24px;
      margin-top: 12px;
      color: var(--success);
      font-size: 14px;
      font-weight: 700;
    }

    .hint {
      margin: 12px 0 0;
      color: var(--muted);
      font-size: 13px;
    }

    .no-script {
      margin: 14px 0 0;
      padding: 12px 14px;
      border: 1px solid var(--accent);
      border-radius: 12px;
      background: var(--accent-soft);
      color: var(--brand-dark);
      font-size: 14px;
      font-weight: 700;
    }

    .noscript-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 16px;
      margin-top: 20px;
    }

    .noscript-signature-box h2 { margin-bottom: 12px; color: var(--brand); }
    .fallback-section { display: block; }
    body.no-js .interactive-grid { display: none; }
    body.js .fallback-section { display: none; }

    .info-icon {
      display: inline-flex; align-items: center; justify-content: center;
      width: 16px; height: 16px; border-radius: 50%; background: var(--accent);
      color: var(--page); font-size: 11px; font-weight: 700; font-style: normal;
      margin-left: 6px; cursor: pointer; position: relative; vertical-align: middle;
    }

    .info-icon .tooltip {
      display: none; position: absolute; bottom: 22px; left: 0; width: 240px;
      background: var(--muted); color: var(--page); font-size: 12px;
      font-weight: 400; font-style: normal; line-height: 1.4; padding: 8px 10px;
      border-radius: 6px; z-index: 10;
    }

    .info-icon:hover .tooltip, .info-icon:focus .tooltip { display: block; }

    .signature-wrap {
      overflow: auto;
      background: var(--page);
    }

    .preview-column {
      display: grid;
      gap: 20px;
    }

    #signature,
    #shortSignature {
      display: inline-block;
      min-width: 300px;
      padding: 12px;
      background: var(--page);
      color: var(--text);
      -webkit-user-select: text;
      user-select: text;
    }

    @media (max-width: 820px) {
      .grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 560px) {
      .page {
        padding: 14px 10px 30px;
      }

      .hero,
      .card {
        border-radius: 14px;
        padding: 16px;
      }

      .form-grid {
        grid-template-columns: 1fr;
      }

      button {
        width: 100%;
      }
    }
  </style>
</head>
