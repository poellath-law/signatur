    const logoUrl = 'https://www.pplaw.com/sites/default/files/2026-07/POELLATH%20Logo%20hochaufl%C3%B6send%20positiv%20f%C3%BCr%20Onlinemedien%20(png).png';
    const websiteUrl = 'https://www.pplaw.com/';
    const companyLinkedInUrl = 'https://www.linkedin.com/company/poellath/';
    const locations = {
      munich: { deName: 'München', enName: 'Munich', address: ['Hofstatt 1', '80331 München'], phonePrefix: '+49 89 24240' },
      frankfurt: { deName: 'Frankfurt', enName: 'Frankfurt', address: ['OpernTurm | Bockenheimer Landstraße 2-4', '60306 Frankfurt aM'], phonePrefix: '+49 69 247047' },
      berlin: { deName: 'Berlin', enName: 'Berlin', address: ['Potsdamer Platz 5', '10785 Berlin'], phonePrefix: '+49 30 25353' }
    };
    const jobTitles = {
      ra: { de: 'Rechtsanwalt', en: 'Attorney-at-Law' },
      rain: { de: 'Rechtsanwältin', en: 'Attorney-at-Law' },
      stb: { de: 'Steuerberater', en: 'Tax Advisor' },
      stbin: { de: 'Steuerberaterin', en: 'Tax Advisor' },
      ra_stb: { de: 'Rechtsanwalt, Steuerberater', en: 'Attorney-at-Law, Tax Advisor' },
      rain_stbin: { de: 'Rechtsanwältin, Steuerberaterin', en: 'Attorney-at-Law, Tax Advisor' }
    };
    const jobTitleSelect = document.getElementById('jobTitle');
    const jobTitleFreetextField = document.getElementById('jobTitleFreetextField');
    const fields = ['title', 'firstName', 'lastName', 'titleSuffix', 'jobTitle', 'jobTitleFreetext', 'position', 'extension', 'mobile', 'email', 'linkedin', 'language', 'location'];
    const form = document.getElementById('signatureForm');
    const signature = document.getElementById('signature');
    const shortSignature = document.getElementById('shortSignature');
    const statusEl = document.getElementById('status');
    const emailInput = document.getElementById('email');
    let emailWasEdited = false;
    let lastSuggestedEmail = emailInput.value;

    function getValue(id) { return document.getElementById(id).value.trim(); }
    function escapeHtml(value) {
      return value.replace(/[&<>'"]/g, function (char) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[char];
      });
    }
    function escapeAttribute(value) { return escapeHtml(value).replace(/`/g, '&#96;'); }
    function normalizeLinkedIn(value) {
      if (!value || /^https?:\/\/www\.linkedin\.com\/?$/i.test(value)) return '';
      const rootProfileMatch = value.match(/^https?:\/\/(?:www\.)?linkedin\.com\/([^/?#]+)\/?$/i);
      if (rootProfileMatch && !/^(in|company|school|showcase)$/i.test(rootProfileMatch[1])) return 'https://www.linkedin.com/in/' + rootProfileMatch[1];
      if (/^https?:\/\//i.test(value)) return value;
      if (/^www\./i.test(value)) return 'https://' + value;
      return value;
    }
    function getLinkedInUsername(value) {
      if (!value || /^https?:\/\/www\.linkedin\.com\/?$/i.test(value)) return '';
      const match = value.match(/linkedin\.com\/in\/([^/?#]+)/i);
      if (match && match[1]) { try { return decodeURIComponent(match[1]); } catch (error) { return match[1]; } }
      const rootProfileMatch = value.match(/^https?:\/\/(?:www\.)?linkedin\.com\/([^/?#]+)\/?$/i);
      const fallback = rootProfileMatch && !/^(in|company|school|showcase)$/i.test(rootProfileMatch[1]) ? rootProfileMatch[1] : value.replace(/^https?:\/\//i, '').replace(/^www\./i, '').replace(/\/$/, '');
      return fallback.toLowerCase() === 'name' ? '' : fallback;
    }
    function normalizeEmailPart(value) {
      return value.toLowerCase().replace(/ä/g, 'ae').replace(/ö/g, 'oe').replace(/ü/g, 'ue').replace(/ß/g, 'ss').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9-]+/g, '').replace(/^-+|-+$/g, '');
    }
    function normalizeMobileNumber(value) {
      let digits = value.replace(/\D/g, '');
      if (digits.startsWith('0049')) digits = digits.slice(4);
      else if (digits.startsWith('49')) digits = digits.slice(2);
      if (digits.startsWith('0')) digits = digits.slice(1);
      if (!digits) return '';
      const areaCode = digits.slice(0, 3);
      const subscriberNumber = digits.slice(3);
      return 'T +49 ' + areaCode + (subscriberNumber ? ' ' + subscriberNumber : '');
    }
    function suggestEmailAddress() {
      if (emailWasEdited && emailInput.value !== lastSuggestedEmail && emailInput.value !== '@pplaw.com') return;
      const firstTokens = getValue('firstName').split(/\s+/).filter(Boolean);
      const lastTokens = getValue('lastName').split(/\s+/).filter(Boolean);
      const first = normalizeEmailPart(firstTokens[0] || '');
      const last = normalizeEmailPart(lastTokens[lastTokens.length - 1] || '');
      const suggestedEmail = first && last ? first + '.' + last + '@pplaw.com' : '@pplaw.com';
      emailInput.value = suggestedEmail;
      lastSuggestedEmail = suggestedEmail;
    }
    function createLine(value) { return value ? escapeHtml(value) + '<br>' : ''; }
    function setStatus(message, isWarning) { statusEl.textContent = message; statusEl.style.color = isWarning ? 'var(--warning)' : 'var(--success)'; }
    function buildSignatureHtml() {
      const title = getValue('title'), firstName = getValue('firstName'), lastName = getValue('lastName'), titleSuffix = getValue('titleSuffix');
      const jobTitleKey = getValue('jobTitle'), position = getValue('position'), extension = getValue('extension'), email = getValue('email'), linkedin = getValue('linkedin');
      const language = getValue('language'), location = locations[getValue('location')] || locations.munich;
      const fullName = [title, firstName, lastName].filter(Boolean).join(' ') + (titleSuffix ? ', ' + titleSuffix : '');
      const websiteHref = language === 'en' ? 'https://www.pplaw.com/en' : websiteUrl;
      const linkedInUsername = getLinkedInUsername(linkedin);
      const newsletterPretext = language === 'en' ? 'Stay informed: ' : 'Bleiben Sie informiert: ';
      const newsletterText = language === 'en' ? 'Sign up for our newsletter' : 'Anmeldung zum Newsletter';
      const newsletterHref = language === 'en' ? 'https://www.pplaw.com/en/newsletter-registration' : 'https://www.pplaw.com/anmeldung-zum-newsletter';
      const addressLines = location.address.map(line => language === 'en' ? line.replace('München', 'Munich') : line);
      const phone = extension ? location.phonePrefix + ' ' + extension : location.phonePrefix;
      const personalLinkedInHref = normalizeLinkedIn(linkedin);
      const personalLinkedIn = personalLinkedInHref && linkedInUsername ? ' | <a href="' + escapeAttribute(personalLinkedInHref) + '" style="color:#000000; text-decoration:underline;">' + escapeHtml(firstName) + '@LinkedIn</a>' : '';
      const emailHtml = email ? '<a href="mailto:' + escapeAttribute(email) + '" style="color:#000000; text-decoration:underline;">' + escapeHtml(email) + '</a>' : '';
      const jobTitle = jobTitleKey === 'freitext' ? getValue('jobTitleFreetext') : (jobTitles[jobTitleKey] ? jobTitles[jobTitleKey][language] : '');
      return '<div style="font-family:Arial, Helvetica, sans-serif; color:#000000; font-size:10pt; line-height:1.25;">' + createLine(fullName) + createLine(jobTitle) + createLine(position) + '<br>'
        + '<a href="' + websiteHref + '" style="text-decoration:none;"><img src="' + logoUrl + '" width="200" alt="POELLATH" style="border:0; width:200px; height:auto; display:block;"></a><br><span style="font-size:10pt; line-height:10pt;">&nbsp;</span><br>'
        + escapeHtml(newsletterPretext) + '<a href="' + newsletterHref + '" style="color:#9C9EA6; text-decoration:underline;">' + escapeHtml(newsletterText) + '</a><br><br>POELLATH<br><span style="font-size:8pt; line-height:1.25;">P+P Pöllath + Partners<br>Rechtsanwälte und Steuerberater mbB<br>'
        + escapeHtml(addressLines[0]) + '<br>' + escapeHtml(addressLines[1]) + '<br>T ' + escapeHtml(phone) + '<br>' + emailHtml + personalLinkedIn + '<br><a href="' + websiteHref + '" style="color:#000000; text-decoration:underline;">www.pplaw.com</a> | <a href="' + companyLinkedInUrl + '" style="color:#000000; text-decoration:underline;">POELLATH@LinkedIn</a></span></div>';
    }
    function buildShortSignatureHtml() {
      const title = getValue('title');
      const firstName = getValue('firstName');
      const lastName = getValue('lastName');
      const titleSuffix = getValue('titleSuffix');
      const mobile = normalizeMobileNumber(getValue('mobile'));
      const fullName = [title, firstName, lastName].filter(Boolean).join(' ') + (titleSuffix ? ', ' + titleSuffix : '');
      return '<table role="presentation" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse; font-family:Arial, Helvetica, sans-serif; color:#000000; font-size:10pt; line-height:1.25;"><tr>'
        + '<td style="padding:0 8px 0 0; vertical-align:top; color:#4DB4F2; font-family:Arial, Helvetica, sans-serif; font-size:12pt; font-weight:bold;">+</td>'
        + '<td style="padding:0; vertical-align:top; color:#7D7F87; font-family:Arial, Helvetica, sans-serif;">'
        + '<span style="font-family:Arial, Helvetica, sans-serif; font-size:12pt; font-weight:bold; color:#7D7F87;">' + escapeHtml(fullName) + '</span>'
        + (mobile ? '<hr style="width:50px; height:2px; margin:5px 0; padding:0; border:0; background-color:#4DB4F2; color:#4DB4F2; text-align:left;"><span style="font-family:Arial, Helvetica, sans-serif; color:#7D7F87;">' + escapeHtml(mobile) + '</span>' : '')
        + '</td>'
        + '</tr></table>';
    }
    function updateSignature(showMessage) {
      signature.innerHTML = buildSignatureHtml();
      shortSignature.innerHTML = buildShortSignatureHtml();
      if (showMessage) setStatus('Signaturen wurden aktualisiert.', false);
    }
    function buildClipboardDocument(element) {
      return '<!doctype html><html><head><meta charset="utf-8"><style>body,table,td,span{font-family:Arial,Helvetica,sans-serif!important;}</style></head><body style="margin:0; font-family:Arial, Helvetica, sans-serif;">'
        + element.innerHTML
        + '</body></html>';
    }
    async function selectAndCopy(element, successMessage) {
      const range = document.createRange(); range.selectNodeContents(element);
      const selection = window.getSelection(); selection.removeAllRanges(); selection.addRange(range);
      const html = buildClipboardDocument(element), text = element.innerText;
      try {
        if (navigator.clipboard && window.ClipboardItem) {
          const item = new ClipboardItem({ 'text/html': new Blob([html], { type: 'text/html' }), 'text/plain': new Blob([text], { type: 'text/plain' }) });
          await navigator.clipboard.write([item]); setStatus(successMessage, false); return;
        }
      } catch (error) { setStatus('Signatur wurde markiert. Direktes Kopieren nicht unterstützt – bitte manuell "Kopieren" wählen.', true); return; }
      setStatus('Signatur wurde markiert. Direktes Kopieren nicht unterstützt – bitte manuell "Kopieren" wählen.', true);
    }
    function selectAndCopySignature() {
      updateSignature(false);
      return selectAndCopy(signature, 'Signatur wurde in die Zwischenablage kopiert.');
    }
    function selectAndCopyShortSignature() {
      updateSignature(false);
      return selectAndCopy(shortSignature, 'Kurzsignatur wurde in die Zwischenablage kopiert.');
    }
    fields.forEach(function (id) {
      document.getElementById(id).addEventListener('input', function () { if (id === 'email') emailWasEdited = true; if (id === 'firstName' || id === 'lastName') suggestEmailAddress(); updateSignature(false); });
      document.getElementById(id).addEventListener('change', function () { if (id === 'firstName' || id === 'lastName') suggestEmailAddress(); updateSignature(false); });
    });
    function toggleJobTitleFreetext() { jobTitleFreetextField.style.display = jobTitleSelect.value === 'freitext' ? 'block' : 'none'; }
    jobTitleSelect.addEventListener('change', toggleJobTitleFreetext); toggleJobTitleFreetext();
    form.addEventListener('submit', function (event) { event.preventDefault(); updateSignature(true); });
    document.getElementById('selectCopyButton').addEventListener('click', selectAndCopySignature);
    document.getElementById('selectCopyShortButton').addEventListener('click', selectAndCopyShortSignature);
    updateSignature(false);
  </script>

</body>
