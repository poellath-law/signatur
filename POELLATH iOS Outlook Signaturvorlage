<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>POELLATH iOS Outlook Signaturvorlage</title>
  <style>
    :root {
      color-scheme: light;
      --brand: #003a5d;
      --brand-dark: #00263d;
      --accent: #e7eef3;
      --text: #1f2933;
      --muted: #5f6b76;
      --border: #d8e0e7;
      --success: #0f766e;
      --warning: #9a3412;
      --surface: #ffffff;
      --page: #f5f7f9;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: var(--page);
      color: var(--text);
      font-family: Arial, Helvetica, sans-serif;
      line-height: 1.45;
    }

    .page {
      width: min(1040px, 100%);
      margin: 0 auto;
      padding: 24px 14px 42px;
    }

    .hero {
      background: linear-gradient(135deg, var(--brand), var(--brand-dark));
      color: #fff;
      border-radius: 20px;
      padding: 24px;
      box-shadow: 0 20px 50px rgba(0, 38, 61, 0.16);
    }

    .hero h1 {
      margin: 0 0 8px;
      font-size: clamp(24px, 6vw, 40px);
      line-height: 1.08;
      letter-spacing: -0.03em;
    }

    .hero p {
      margin: 0;
      max-width: 760px;
      color: rgba(255, 255, 255, 0.88);
      font-size: 16px;
    }

    .grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(320px, 430px);
      gap: 20px;
      margin-top: 20px;
      align-items: start;
    }

    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 18px;
      box-shadow: 0 12px 34px rgba(31, 41, 51, 0.08);
    }

    .card h2 {
      margin: 0 0 14px;
      font-size: 20px;
      letter-spacing: -0.01em;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .field {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .field.full {
      grid-column: 1 / -1;
    }

    label {
      font-size: 13px;
      font-weight: 700;
      color: var(--brand-dark);
    }

    input,
    select {
      width: 100%;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 12px 13px;
      color: var(--text);
      background: #fff;
      font: 16px Arial, Helvetica, sans-serif;
      outline: none;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    input:focus,
    select:focus {
      border-color: var(--brand);
      box-shadow: 0 0 0 4px rgba(0, 58, 93, 0.12);
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 18px;
    }

    button {
      appearance: none;
      border: 0;
      border-radius: 999px;
      padding: 12px 16px;
      font: 700 15px Arial, Helvetica, sans-serif;
      cursor: pointer;
      transition: transform 0.12s ease, box-shadow 0.12s ease, background 0.12s ease;
    }

    button:active {
      transform: translateY(1px);
    }

    .primary {
      color: #fff;
      background: var(--brand);
      box-shadow: 0 8px 18px rgba(0, 58, 93, 0.2);
    }

    .secondary {
      color: var(--brand-dark);
      background: var(--accent);
    }

    .status {
      min-height: 24px;
      margin-top: 12px;
      color: var(--success);
      font-size: 14px;
      font-weight: 700;
    }

    .hint {
      margin: 12px 0 0;
      color: var(--muted);
      font-size: 13px;
    }

    .signature-wrap {
      overflow: auto;
      background: #fff;
    }

    #signature {
      display: inline-block;
      min-width: 300px;
      padding: 12px;
      background: #fff;
      color: #000;
      -webkit-user-select: text;
      user-select: text;
    }

    @media (max-width: 820px) {
      .grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 560px) {
      .page {
        padding: 14px 10px 30px;
      }

      .hero,
      .card {
        border-radius: 14px;
        padding: 16px;
      }

      .form-grid {
        grid-template-columns: 1fr;
      }

      button {
        width: 100%;
      }
    }
  </style>
</head>
<body>
  <main class="page">
    <section class="hero" aria-labelledby="page-title">
      <h1 id="page-title">POELLATH iOS Outlook Signaturvorlage</h1>
      <p>Persönliche Daten eintragen, Standort und Sprache auswählen, Signatur markieren und in Outlook für iOS einfügen.</p>
    </section>

    <section class="grid">
      <form class="card" id="signatureForm" autocomplete="on">
        <h2>Daten eingeben</h2>
        <div class="form-grid">
          <div class="field">
            <label for="title">Titel</label>
            <input id="title" name="title" type="text" placeholder="Dr.">
          </div>
          <div class="field">
            <label for="firstName">Vorname</label>
            <input id="firstName" name="firstName" type="text" placeholder="Max">
          </div>
          <div class="field">
            <label for="lastName">Nachname</label>
            <input id="lastName" name="lastName" type="text" placeholder="Mustermann">
          </div>
          <div class="field">
            <label for="jobTitle">Berufsbezeichnung</label>
            <input id="jobTitle" name="jobTitle" type="text" placeholder="Rechtsanwalt">
          </div>
          <div class="field full">
            <label for="position">Position</label>
            <input id="position" name="position" type="text" placeholder="Associate">
          </div>
          <div class="field">
            <label for="extension">Durchwahl</label>
            <input id="extension" name="extension" type="tel" inputmode="tel" placeholder="123">
          </div>
          <div class="field">
            <label for="email">E-Mail-Adresse</label>
            <input id="email" name="email" type="email" placeholder="vorname.nachname@pplaw.com">
          </div>
          <div class="field full">
            <label for="linkedin">Persönlicher LinkedIn-Link oder LinkedIn-Text</label>
            <input id="linkedin" name="linkedin" type="text" placeholder="https://www.linkedin.com/in/name">
          </div>
          <div class="field">
            <label for="language">Sprache</label>
            <select id="language" name="language">
              <option value="de">Deutsch</option>
              <option value="en">Englisch</option>
            </select>
          </div>
          <div class="field">
            <label for="location">Standort</label>
            <select id="location" name="location">
              <option value="munich">München</option>
              <option value="frankfurt">Frankfurt</option>
              <option value="berlin">Berlin</option>
            </select>
          </div>
        </div>
        <div class="actions">
          <button class="secondary" type="button" id="refreshButton">Signatur aktualisieren</button>
          <button class="primary" type="button" id="selectButton">Signatur markieren</button>
          <button class="secondary" type="button" id="copyButton">Direkt kopieren</button>
        </div>
        <div class="status" id="status" role="status" aria-live="polite"></div>
        <p class="hint">Tipp für iOS: Nach „Signatur markieren“ im markierten Bereich lange drücken und „Kopieren“ wählen.</p>
      </form>

      <section class="card">
        <h2>Fertige Signatur</h2>
        <div class="signature-wrap">
          <div id="signature"></div>
        </div>
      </section>
    </section>
  </main>

  <script>
    const logoUrl = 'https://www.pplaw.com/sites/default/files/2026-06/POELLATH-Logo-positiv-Signatur-240px.png';
    const websiteUrl = 'https://www.pplaw.com/';
    const companyLinkedInUrl = 'https://www.linkedin.com/company/poellath/';

    const locations = {
      munich: {
        deName: 'München',
        enName: 'Munich',
        address: ['Hofstatt 1', '80331 München'],
        phonePrefix: '+49 89 24240'
      },
      frankfurt: {
        deName: 'Frankfurt',
        enName: 'Frankfurt',
        address: ['OpernTurm | Bockenheimer Landstraße 2-4', '60306 Frankfurt aM'],
        phonePrefix: '+49 69 247047'
      },
      berlin: {
        deName: 'Berlin',
        enName: 'Berlin',
        address: ['Potsdamer Platz 5', '10785 Berlin'],
        phonePrefix: '+49 30 25353'
      }
    };

    const fields = ['title', 'firstName', 'lastName', 'jobTitle', 'position', 'extension', 'email', 'linkedin', 'language', 'location'];
    const form = document.getElementById('signatureForm');
    const signature = document.getElementById('signature');
    const statusEl = document.getElementById('status');

    function getValue(id) {
      return document.getElementById(id).value.trim();
    }

    function escapeHtml(value) {
      return value.replace(/[&<>'"]/g, function (char) {
        return {
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          "'": '&#39;',
          '"': '&quot;'
        }[char];
      });
    }

    function escapeAttribute(value) {
      return escapeHtml(value).replace(/`/g, '&#96;');
    }

    function normalizeLinkedIn(value) {
      if (!value) {
        return '';
      }

      if (/^https?:\/\//i.test(value)) {
        return value;
      }

      if (/^www\./i.test(value)) {
        return 'https://' + value;
      }

      return value;
    }

    function createLine(value) {
      return value ? escapeHtml(value) + '<br>' : '';
    }

    function setStatus(message, isWarning) {
      statusEl.textContent = message;
      statusEl.style.color = isWarning ? 'var(--warning)' : 'var(--success)';
    }

    function buildSignatureHtml() {
      const title = getValue('title');
      const firstName = getValue('firstName');
      const lastName = getValue('lastName');
      const jobTitle = getValue('jobTitle');
      const position = getValue('position');
      const extension = getValue('extension');
      const email = getValue('email');
      const linkedin = getValue('linkedin');
      const language = getValue('language');
      const locationKey = getValue('location');
      const location = locations[locationKey] || locations.munich;
      const fullName = [title, firstName, lastName].filter(Boolean).join(' ');
      const nameForLinkedIn = [firstName, lastName].filter(Boolean).join(' ') || 'Name';
      const newsletterText = language === 'en' ? 'Stay informed: Sign up for our newsletter' : 'Bleiben Sie informiert: Anmeldung zum Newsletter';
      const newsletterHref = language === 'en' ? 'https://www.pplaw.com/en/newsletter-registration' : 'https://www.pplaw.com/anmeldung-zum-newsletter';
      const addressLines = location.address.map(function (line) {
        return language === 'en' ? line.replace('München', 'Munich') : line;
      });
      const phone = extension ? location.phonePrefix + ' ' + extension : location.phonePrefix;
      const personalLinkedInHref = normalizeLinkedIn(linkedin);
      const personalLinkedIn = personalLinkedInHref
        ? ' | <a href="' + escapeAttribute(personalLinkedInHref) + '" style="color:#000000; text-decoration:none;">' + escapeHtml(nameForLinkedIn) + '@LinkedIn</a>'
        : '';
      const emailHtml = email
        ? '<a href="mailto:' + escapeAttribute(email) + '" style="color:#000000; text-decoration:none;">' + escapeHtml(email) + '</a>'
        : '';

      return ''
        + '<div style="font-family:Arial, Helvetica, sans-serif; color:#000000; font-size:10pt; line-height:1.25;">'
        + createLine(fullName)
        + createLine(jobTitle)
        + createLine(position)
        + '<br>'
        + '<a href="' + websiteUrl + '" style="text-decoration:none;"><img src="' + logoUrl + '" width="240" alt="POELLATH" style="border:0; width:240px; height:auto; display:block;"></a><br>'
        + '<a href="' + newsletterHref + '" style="color:#000000; text-decoration:none;">' + newsletterText + '</a><br><br>'
        + 'POELLATH<br>'
        + '<span style="font-size:8pt; line-height:1.25;">'
        + 'P+P Pöllath + Partners<br>'
        + 'Rechtsanwälte und Steuerberater mbB<br>'
        + escapeHtml(addressLines[0]) + '<br>'
        + escapeHtml(addressLines[1]) + '<br>'
        + 'T ' + escapeHtml(phone) + '<br>'
        + emailHtml + personalLinkedIn + '<br>'
        + '<a href="' + websiteUrl + '" style="color:#000000; text-decoration:none;">www.pplaw.com</a> | '
        + '<a href="' + companyLinkedInUrl + '" style="color:#000000; text-decoration:none;">POELLATH@LinkedIn</a>'
        + '</span>'
        + '</div>';
    }

    function updateSignature(showMessage) {
      signature.innerHTML = buildSignatureHtml();
      if (showMessage) {
        setStatus('Signatur wurde aktualisiert.', false);
      }
    }

    function selectSignature() {
      updateSignature(false);
      const range = document.createRange();
      range.selectNodeContents(signature);
      const selection = window.getSelection();
      selection.removeAllRanges();
      selection.addRange(range);
      setStatus('Signatur wurde markiert. Jetzt Kopieren wählen.', false);
    }

    async function copySignature() {
      updateSignature(false);
      const html = signature.innerHTML;
      const text = signature.innerText;

      try {
        if (navigator.clipboard && window.ClipboardItem) {
          const item = new ClipboardItem({
            'text/html': new Blob([html], { type: 'text/html' }),
            'text/plain': new Blob([text], { type: 'text/plain' })
          });
          await navigator.clipboard.write([item]);
          setStatus('Signatur wurde in die Zwischenablage kopiert.', false);
          return;
        }
      } catch (error) {
        selectSignature();
        setStatus('Direktes Kopieren wird nicht unterstützt. Signatur wurde markiert; bitte Kopieren wählen.', true);
        return;
      }

      selectSignature();
      setStatus('Direktes Kopieren wird nicht unterstützt. Signatur wurde markiert; bitte Kopieren wählen.', true);
    }

    fields.forEach(function (id) {
      document.getElementById(id).addEventListener('input', function () {
        updateSignature(false);
      });
      document.getElementById(id).addEventListener('change', function () {
        updateSignature(false);
      });
    });

    form.addEventListener('submit', function (event) {
      event.preventDefault();
      updateSignature(true);
    });

    document.getElementById('refreshButton').addEventListener('click', function () {
      updateSignature(true);
    });
    document.getElementById('selectButton').addEventListener('click', selectSignature);
    document.getElementById('copyButton').addEventListener('click', copySignature);

    updateSignature(false);
  </script>
</body>
</html>
